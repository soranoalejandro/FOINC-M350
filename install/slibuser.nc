O9199(G199)
G90 G01 X#6Y#7Z#8 F#15
M99

O9182(G182 Corte de sierra en el eje X)
// quitar el signo positivo o negativo de la medida Z
#2 = ABS[#2]
// F
IF #15 > 0 GOTO10
#15 = #561 (velocidad de avance por defecto)
N10
G91 G01 Z-[#2] F#15
G01 X#0 F#15
G00 Z#2
M99

O9184(G184 Corte de sierra en el eje Y)
// quitar el signo positivo o negativo de la medida Z
#2 = ABS[#2]
// F
IF #15 > 0 GOTO10
#15 = #561 (velocidad de avance por defecto)
N10
G91 G01 Z-[#2] F#15
G01 Y#1 F#15
G00 Z#2
M99

